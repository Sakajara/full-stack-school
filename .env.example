# Copy to .env.local and fill in from Firebase console > Project settings >
# Your apps > Web app. These values are public by design; security comes from
# firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Leave the project id empty (or use one starting with "demo-") to run
# against the local emulators: npm run dev:emulators
NEXT_PUBLIC_USE_EMULATORS=false
