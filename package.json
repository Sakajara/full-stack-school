{
  "name": "chuo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "firebase emulators:start --only auth,firestore --project demo-chuo",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chuo \"vitest run tests/rules\"",
    "deploy": "next build && firebase deploy --only hosting,firestore --project prod",
    "test:flow": "firebase emulators:exec --only auth,firestore --project demo-chuo \"vitest run tests/integration\"",
    "seed:structure": "tsx --env-file=.env.local scripts/seed-structure.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@types/react-big-calendar": "^1.8.9",
    "firebase": "^12.19.0",
    "moment": "^2.30.1",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-toastify": "^11.1.0",
    "recharts": "^2.15.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.26",
    "firebase-tools": "^15.30.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
